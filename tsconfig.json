{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./assets/js",
    "rootDir": "./assets/ts",
    "declaration": false,
    "removeComments": false,
    "allowJs": true
  },
  "include": ["assets/ts/**/*"],
  "exclude": ["node_modules", "assets/js/**/*"]
}
